<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="@color/secondaryColor"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".view.details.DetailsActivity">

    <Space
        android:layout_width="wrap_content"
        android:layout_height="50dp"/>
    <LinearLayout
        android:paddingVertical="20dp"
        android:orientation="vertical"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:backgroundTint="@color/secondaryColor2"
        android:background="@drawable/button_corner_radius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_marginLeft="20dp"
            android:gravity="center"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView

                android:src="@drawable/qr_image"
                android:layout_width="35dp"
                android:layout_height="35dp"/>
            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            <TextView
                android:id="@+id/qrTypeTitle"
                android:text="Data"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"/>
                <TextView
                    android:id="@+id/dateTimevalue"
                    android:text="16 Dec 2022, 9:30 pm"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>
        <Space
            android:layout_width="wrap_content"
            android:layout_height="10dp"/>
        <TextView
            android:id="@+id/value"
            android:layout_marginLeft="20dp"
            android:layout_weight="1"
            android:textColor="@color/whiteTextOpacityColor"
            android:text="https://www.youtube.com/watch?v=tOlJTtdz7UYlist==3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
    <Space
        android:layout_width="wrap_content"
        android:layout_height="50dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

       <LinearLayout
           android:orientation="vertical"
           android:layout_width="wrap_content"
           android:layout_height="wrap_content">
           <LinearLayout
               android:id="@+id/share"
               android:backgroundTint="@color/primaryColor"
               android:background="@drawable/button_corner_radius"
               android:orientation="vertical"
               android:padding="15dp"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content">
               <ImageView
                   android:src="@drawable/ic_share"
                   android:layout_width="30dp"
                   android:layout_height="30dp"/>
           </LinearLayout>

           <Space
               android:layout_width="wrap_content"
               android:layout_height="10dp"/>
           <TextView
               android:layout_gravity="center"
               android:text="Share"
               android:textColor="@color/white"
               android:textSize="17dp"
               android:textStyle="bold"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"/>
       </LinearLayout>
        <Space
            android:layout_width="20dp"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/copy"
                android:backgroundTint="@color/primaryColor"
                android:background="@drawable/button_corner_radius"
                android:orientation="vertical"
                android:padding="15dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:src="@drawable/ic_copy"
                    android:layout_width="30dp"
                    android:layout_height="30dp"/>
            </LinearLayout>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="10dp"/>
            <TextView
                android:layout_gravity="center"
                android:text="Copy"
                android:textColor="@color/white"
                android:textSize="17dp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp"/>
    <!--        qr image view-->

    <LinearLayout
        android:id="@+id/qrImageViewLayout"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/qrImageview"
            android:scaleType="fitXY"
            android:layout_gravity="center"
            android:layout_width="250dp"
            android:layout_height="250dp"/>

        <LinearLayout

            android:id="@+id/saveToGallery"
            android:layout_margin="10dp"
            android:background="@drawable/button_corner_radius"
            android:backgroundTint="@color/primaryColor"
            android:layout_gravity="center"
            android:layout_width="200dp"
            android:layout_height="40dp">
            <TextView
                android:gravity="center"
                android:textAlignment="center"
                android:text="Save To Gallery"
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>